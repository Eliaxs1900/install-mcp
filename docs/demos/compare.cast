[57.4695, "o", "\r\n\u001b[1m\u001b[34m━━ RESULTADO (medido en esta ejecución) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m                                 ANTES (Bash + pip)                     DESPUÉS (install-mcp)\u001b[0m\r\n  El agente recupera el control  \u001b[31m8.0 s (límite Bash; 120 s real)       \u001b[0m \u001b[32m0.04 s\u001b[0m\r\n  Durante la compilación ve…     \u001b[31mlog congelado en 'Building wheel…'    \u001b[0m \u001b[32mestado, pid, comando, s sin salida\u001b[0m\r\n  Aviso de atasco                \u001b[31mninguno                               \u001b[0m \u001b[32m'stalled' a los 7.0 s\u001b[0m\r\n"]
